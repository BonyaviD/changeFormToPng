# Server-only. Generate fresh values with npm run auth:setup.
# Never prefix these with NEXT_PUBLIC_ or commit .env.local.
SARA_AUTH_USERNAME=
SARA_AUTH_PASSWORD_HASH=
SARA_SESSION_SECRET=

# Optional: a shared certificate archive on Upstash Redis. Without these, each
# browser keeps its own archive. Vercel's "Upstash for Redis" integration sets
# them for you; a database made on upstash.com calls them
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN, which also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
